{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "plantidget",
  "version": "0.1.0",
  "identifier": "com.sanio.plantidget",
  "build": {
    "frontendDist": "../src"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "title": "Plant Dashboard",
        "label": "main",
        "url": "main.html",
        "visible": true
      },
      {
        "title": "Plant Widget",
        "url": "widget.html",
        "label": "widget",
        "width": 250,
        "height": 270,
        "decorations": false,
        "resizable": false,
        "alwaysOnTop":true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}
